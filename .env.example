# Copy to .env and fill locally. Never commit .env.

# Application
APP_ENV=development
APP_PORT=8080
TIMEZONE=America/Campo_Grande

# Supabase / PostgreSQL
SUPABASE_URL=
SUPABASE_ANON_KEY=
DATABASE_URL=

# Zernio
ZERNIO_BASE_URL=
ZERNIO_API_KEY=

# Ryze
RYZE_BASE_URL=
RYZE_API_KEY=
RYZE_INSTANCE=
RYZE_ACCOUNT=
RYZE_WEBHOOK_SECRET=

# OmniRoute
OMNIROUTE_BASE_URL=
OMNIROUTE_API_KEY=
OMNIROUTE_MODEL=
OMNIROUTE_TIMEOUT_MS=30000
OMNIROUTE_STREAMING=false

# Composio / Cal.com
COMPOSIO_API_KEY=
COMPOSIO_CONNECTION_ID=
CALCOM_EVENT_TYPE=

# Trello
TRELLO_API_KEY=
TRELLO_TOKEN=
TRELLO_BOARD_ID=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Runtime safety
DRY_RUN=true
EXTERNAL_SEND_ENABLED=false
