# /etc/systemd/system/finance-frontend.service
[Unit]
Description=api-finance Next.js frontend
After=network.target

[Service]
Type=simple
WorkingDirectory=/root/projects/finance-frontend
Environment=NODE_ENV=production
Environment=PATH=/root/.hermes/node/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=NEXT_PUBLIC_APP_URL=https://finance.iainfinito.com.br
Environment=NEXT_PUBLIC_API_BASE_URL=https://finance.iainfinito.com.br/api/v1
Environment=NEXT_PUBLIC_OPENAPI_JSON_URL=https://finance.iainfinito.com.br/api-json/openapi.json
ExecStart=/root/.hermes/node/bin/npm run start -- --hostname 0.0.0.0 --port 3100
Restart=always
RestartSec=5
User=root

[Install]
WantedBy=multi-user.target
